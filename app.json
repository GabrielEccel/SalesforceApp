{
  "expo": {
    "name": "SalesforceApp",
    "slug": "SalesforceApp",
    "scheme": "salesforceapp",
    "version": "1.0.0",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/ios-icon.png"
    },
    "android": {
      "icon": "./assets/adaptive-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.SalesforceApp"
    },
    "web": {
      "favicon": "./assets/adaptive-icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "177712d7-91ae-4d5d-827a-7d5a0aa5c469"
      }
    }
  }
}
